# 複製成 .env 後填值（.env 不會進 git）

# 本機開發：1 = 可跳過 Google 登入（在 Cloud Run 上一律自動關閉）
DEV_LOGIN=1

# 資料庫：不填就用本機 SQLite（local.db）。部署時填 Neon 的連線字串
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 簽 cookie 用的亂數，產生方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Google 登入（GCP Console → APIs & Services → Credentials → OAuth client ID）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 允許登入的信箱，多個用逗號分隔
ALLOWED_EMAILS=lithium8578@gmail.com

# Obsidian vault 名稱，用來產生 obsidian:// 連結
OBSIDIAN_VAULT=Obsidian-Master
